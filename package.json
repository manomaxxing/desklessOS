{
  "name": "deskless-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DesklessOS: voice-first assistant for tradespeople. Phone call in, notes out.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "live-probe": "node --env-file-if-exists=.env scripts/live-probe.mjs",
    "fake-dial": "node --env-file-if-exists=.env scripts/fake-dial.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "dial": "node --env-file-if-exists=.env scripts/dial.mjs",
    "test": "node --test test/*.test.mjs",
    "report": "node --env-file-if-exists=.env scripts/report.mjs",
    "regress": "node --env-file-if-exists=.env scripts/regress.mjs",
    "locale:check": "node scripts/locale-check.mjs",
    "admin:totp": "node scripts/admin-totp.mjs",
    "migrate:pg": "node --env-file-if-exists=.env scripts/migrate-json-to-pg.mjs",
    "smart-turn:fetch": "node scripts/smart-turn-fetch.mjs",
    "whatsapp:setup": "node --env-file-if-exists=deploy/env.production scripts/whatsapp-setup.mjs"
  },
  "dependencies": {
    "opusscript": "0.1.1",
    "postgres": "3.4.9",
    "werift": "0.24.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.30.0"
  }
}
