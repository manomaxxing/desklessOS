# DesklessOS production settings. Copy to deploy/env.production (git-ignored), fill in,
# and deploy/cloudrun.sh stores the whole file as ONE Secret Manager secret, mounted
# into the service at /secrets/env (one secret keeps Secret Manager in its free tier).
# Set by the deploy script, not here: GOOGLE_CLOUD_PROJECT, PUBLIC_URL, BACKGROUND=http.

# ---- required ----
# Supabase (EU, eu-central-1): Project Settings → Database → Connection string → "Session pooler"
# (port 5432; IPv4, and LISTEN/NOTIFY works there, unlike the transaction pooler on 6543).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Sharing a Supabase project with another app: own schema and login (docs/architecture.md §10)
# DB_SCHEMA=deskless
FISH_AUDIO_API_KEY=
# Cloud Scheduler sends this to /internal/tick every minute (openssl rand -hex 24)
TICK_TOKEN=
# The API, monitor and test phone (?token=…); and/or the admin login below
DEV_TOKEN=
GEMINI_MODEL=gemini-3.5-flash
# Phone calls: cascade (Gemini hears, Fish speaks) | live (Gemini Live, ~1 s faster, less turn-taking control)
# ENGINE=cascade
# LIVE_MODEL=vertex-eu:gemini-3.8-live
# LIVE_VOICE=Kore
# GOOGLE_CLOUD_LOCATION=global

# ---- admin page (/admin) ----
# The owner's code (log in with an empty email): to invite the team, who then have their own
# email and password (People → Who can log in here), and as a spare key.
ADMIN_CODE=
# npm run admin:totp
ADMIN_TOTP_SECRET=
# openssl rand -hex 32
SESSION_SECRET=
# where results go: a webhook (Slack, Make, n8n …) and/or email through Resend
NOTIFY_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# ---- phone lines ----
# Dial (US number): its signing secret
DIAL_SIGNING_SECRET=
# Twilio (German number, EU region): the number's voice webhook is <PUBLIC_URL>/twilio/voice (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_REGION=ie1
TWILIO_EDGE=dublin
# WhatsApp calls (Meta Cloud API): a system user's token, the number's id (not the number),
# the app's id and secret. Calls run on a second service (deploy/cloudrun.sh); then
# npm run whatsapp:setup -- <that service>/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# calls we make: twilio | off
OUTBOUND=off
OUTBOUND_PER_DAY=1
# Max's own line, and the PIN to approve by phone
ADMIN_PHONE=
ADMIN_PIN=

# ---- tuning (defaults are fine) ----
# MASK=typing
# DB_POOL=4   (keep instances × (DB_POOL + 1) under the login's connection limit)
# FISH_MODEL=s2.1-pro-free
